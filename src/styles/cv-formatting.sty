\ProvidesPackage{styles/cv-formatting}[2026/11/01 ATS CV Polish]

% Required Packages
\RequirePackage{latexsym}
\RequirePackage[empty]{fullpage}
\RequirePackage{titlesec}
\RequirePackage{marvosym}
\RequirePackage[usenames,dvipsnames,svgnames,HTML]{xcolor}
\RequirePackage{verbatim}
\RequirePackage{enumitem}
\RequirePackage[hidelinks]{hyperref}
\RequirePackage{fancyhdr}
\RequirePackage[english]{babel}
\RequirePackage{tabularx}
\RequirePackage{fontawesome}
\RequirePackage{needspace}
\input{glyphtounicode}

% ---------- Color tokens (shared with Swiss Portfolio resume) ----------
\definecolor{cvlabel}{HTML}{09090B}
\definecolor{cvsecondary}{HTML}{3F3F46}
\definecolor{cvseparator}{HTML}{E4E4E7}
\definecolor{cvaccent}{HTML}{2563EB}

\pagestyle{fancy}
\fancyhf{}
\fancyfoot{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}

% Adjust margins
\addtolength{\oddsidemargin}{-0.5in}
\addtolength{\evensidemargin}{-0.5in}
\addtolength{\textwidth}{1in}
\addtolength{\topmargin}{-.5in}
\addtolength{\textheight}{1.0in}

\urlstyle{same}
\color{cvlabel}

\raggedbottom
\raggedright
\setlength{\tabcolsep}{0in}

% Sections: sentence-case bold + accent tick + hairline (ATS-safe, no small-caps)
\titleformat{\section}{
  \vspace{-4pt}\raggedright\large\bfseries\color{cvlabel}
}{}{0em}{}[%
  \vspace{2pt}%
  {\color{cvaccent}\rule{14pt}{1.2pt}}%
  {\color{cvseparator}\rule{\dimexpr\textwidth-14pt\relax}{0.4pt}}%
  \vspace{-5pt}%
]

% Machine-readable / ATS-parsable
\pdfgentounicode=1

\hypersetup{urlcolor=cvaccent,linkcolor=cvaccent}

%-------------------------
% Custom commands
\newcommand{\resumeItem}[1]{
  \item\small{
    {#1 \vspace{-2pt}}
  }
}

\newcommand{\resumeSubheading}[4]{
  \vspace{-2pt}\item
    \begin{tabular*}{0.97\textwidth}[t]{l@{\extracolsep{\fill}}r}
      \textbf{\color{cvlabel}#1} & \color{cvsecondary}#2 \\
      \textit{\small\color{cvsecondary}#3} & \textit{\small\color{cvsecondary}#4} \\
    \end{tabular*}\vspace{-7pt}
}

\newcommand{\resumeSubSubheading}[2]{
    \item
    \begin{tabular*}{0.97\textwidth}{l@{\extracolsep{\fill}}r}
      \textit{\small\color{cvsecondary}#1} & \textit{\small\color{cvsecondary}#2} \\
    \end{tabular*}\vspace{-7pt}
}

\newcommand{\resumeProjectHeading}[2]{
    \item
    \begin{tabular*}{0.97\textwidth}{l@{\extracolsep{\fill}}r}
      \small\color{cvlabel}#1 & \color{cvsecondary}#2 \\
    \end{tabular*}\vspace{-7pt}
}

\newcommand{\resumeSubItem}[1]{\resumeItem{#1}\vspace{-4pt}}

\renewcommand\labelitemii{\color{cvsecondary}\textbullet}

\newcommand{\resumeSubHeadingListStart}{\begin{itemize}[leftmargin=0.15in, label={}]}
\newcommand{\resumeSubHeadingListEnd}{\end{itemize}}
\newcommand{\resumeItemListStart}{\begin{itemize}[leftmargin=*, label={\color{cvsecondary}\textbullet}]}
\newcommand{\resumeItemListEnd}{\end{itemize}\vspace{-5pt}}

\setlength{\parindent}{0pt}
