% =============================================================================
% Resume design system (print, XeLaTeX) — Swiss Portfolio 2026
% Zinc monochrome + blue accent; Archivo display / Space Grotesk body.
% =============================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{styles/resume-formatting}[2026/11/01 Swiss Portfolio Resume]

\RequirePackage[letterpaper,margin=0.5in,top=0.45in,bottom=0.4in]{geometry}
\RequirePackage{xcolor}
\RequirePackage{fontspec}
\RequirePackage{graphicx}
\RequirePackage{tikz}
\RequirePackage{fontawesome5}
\RequirePackage{array}
\RequirePackage[hidelinks]{hyperref}

% ---------- Color tokens (ui-ux-pro-max Portfolio/Personal) ----------
\definecolor{cvlabel}{HTML}{09090B}
\definecolor{cvsecondary}{HTML}{3F3F46}
\definecolor{cvtertiary}{HTML}{475569}
\definecolor{cvseparator}{HTML}{E4E4E7}
\definecolor{cvgrouped}{HTML}{E8ECF0}
\definecolor{cvblue}{HTML}{2563EB}
\definecolor{cvaccent}{HTML}{2563EB}

% ---------- Type: vendored OFL → TeX Gyre Heros → Latin Modern Sans ----------
\newcommand{\cvLoadVendoredFonts}{%
  \setmainfont{SpaceGrotesk}[%
    Path=fonts/,
    Extension=.ttf,
    UprightFont=*-Regular,
    BoldFont=*-Bold
  ]%
  \setsansfont{SpaceGrotesk}[%
    Path=fonts/,
    Extension=.ttf,
    UprightFont=*-Regular,
    BoldFont=*-Bold
  ]%
  \newfontfamily\cvDisplayFont{Archivo}[%
    Path=fonts/,
    Extension=.ttf,
    UprightFont=*-Regular,
    BoldFont=*-Bold
  ]%
}
\newcommand{\cvLoadFallbackFonts}{%
  \IfFontExistsTF{TeX Gyre Heros}{%
    \setmainfont{TeX Gyre Heros}%
    \setsansfont{TeX Gyre Heros}%
  }{%
    \setmainfont{Latin Modern Sans}%
    \setsansfont{Latin Modern Sans}%
  }%
  \let\cvDisplayFont\sffamily
}
\newcommand{\cvTryFonts}{%
  \IfFileExists{fonts/SpaceGrotesk-Regular.ttf}{%
    \IfFileExists{fonts/Archivo-Regular.ttf}{%
      \cvLoadVendoredFonts
    }{\cvLoadFallbackFonts}%
  }{\cvLoadFallbackFonts}%
}
\cvTryFonts
\renewcommand{\familydefault}{\sfdefault}

% Print type scale
\newcommand{\cvLargeTitle}{\fontsize{24}{28}\selectfont\bfseries}
\newcommand{\cvTitleB}{\fontsize{18}{22}\selectfont\bfseries}
\newcommand{\cvHeadline}{\fontsize{10.5}{13}\selectfont\bfseries}
\newcommand{\cvTypeBody}{\fontsize{9.2}{11.8}\selectfont}
\newcommand{\cvCallout}{\fontsize{9.5}{12.5}\selectfont}
\newcommand{\cvSubhead}{\fontsize{10}{13}\selectfont\bfseries}
\newcommand{\cvFootnote}{\fontsize{8.5}{11}\selectfont}
\newcommand{\cvCaptionA}{\fontsize{8}{10}\selectfont}
\newcommand{\cvCaptionB}{\fontsize{7.5}{9.5}\selectfont}

\color{cvlabel}
\pagestyle{empty}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}
\setlength{\emergencystretch}{1.5em}
\hyphenpenalty=10000 \exhyphenpenalty=10000
\hypersetup{%
  urlcolor=cvaccent,
  linkcolor=cvaccent,
  pdftitle={Marcus Chan -- Resume},
  pdfauthor={Marcus Chan}}

% ---------- Hairline (border + short accent tick) ----------
\newcommand{\cvHairline}{%
  \par\vspace{1pt}%
  \noindent
  {\color{cvaccent}\rule{28pt}{1.5pt}}%
  {\color{cvseparator}\rule{\dimexpr\textwidth-28pt\relax}{0.5pt}}%
  \par\vspace{6pt}}

% ---------- Header ----------
\newcommand{\cvPhotoSize}{0.72in}
\newcommand{\cvPhotoRadius}{4pt}
\def\cvNameText{}\def\cvTitleText{}\def\cvPhotoPath{}\def\cvContactList{}

\newcommand{\cvHeader}[2]{\gdef\cvNameText{#1}\gdef\cvTitleText{#2}}
\newcommand{\cvPhoto}[1]{\gdef\cvPhotoPath{#1}}

\newcommand{\cvIconEmail}{{\color{cvsecondary}\footnotesize\faEnvelope}}
\newcommand{\cvIconWebsite}{{\color{cvsecondary}\footnotesize\faGlobe}}
\newcommand{\cvIconLinkedIn}{{\color{cvsecondary}\footnotesize\faLinkedin}}

\newcommand{\cvContact}[2]{%
  \g@addto@macro\cvContactList{%
    \makebox[1.05em][l]{#1}{\cvFootnote\color{cvsecondary}#2}\par\vspace{1pt}}}

\newcommand{\cvPhotoBox}{%
  \IfFileExists{\cvPhotoPath}{%
    \begin{tikzpicture}
      \clip[rounded corners=\cvPhotoRadius] (0,0) rectangle (\cvPhotoSize,\cvPhotoSize);
      \node[inner sep=0pt,anchor=center]
        at (0.5*\cvPhotoSize,0.5*\cvPhotoSize)
        {\includegraphics[width=\cvPhotoSize,height=\cvPhotoSize]{\cvPhotoPath}};
    \end{tikzpicture}%
  }{%
    \begin{tikzpicture}
      \fill[rounded corners=\cvPhotoRadius,cvgrouped]
        (0,0) rectangle (\cvPhotoSize,\cvPhotoSize);
      \draw[cvseparator,rounded corners=\cvPhotoRadius]
        (0,0) rectangle (\cvPhotoSize,\cvPhotoSize);
      \node[font=\cvCaptionB\color{cvtertiary}]
        at (0.5*\cvPhotoSize,0.5*\cvPhotoSize) {Photo};
    \end{tikzpicture}%
  }}

\newcommand{\cvRenderHeader}{%
  \noindent
  \begin{minipage}[c]{\cvPhotoSize}\cvPhotoBox\end{minipage}%
  \hspace{14pt}%
  \begin{minipage}[c]{0.48\textwidth}
    {\cvLargeTitle\cvDisplayFont\color{cvlabel}\cvNameText\par}
    \vspace{3pt}
    {\cvCallout\color{cvsecondary}\cvTitleText\par}
  \end{minipage}%
  \hfill
  \begin{minipage}[c]{0.28\textwidth}
    \raggedleft\cvContactList
  \end{minipage}\par
  \cvHairline
}

% ---------- Sections: sentence case + accent/border rule ----------
\newcommand{\cvSection}[1]{%
  \vspace{7pt}%
  {\cvHeadline\color{cvlabel}#1\par}%
  \vspace{2pt}%
  \noindent
  {\color{cvaccent}\rule{14pt}{1.2pt}}%
  {\color{cvseparator}\rule{\dimexpr\linewidth-14pt\relax}{0.4pt}}%
  \par\vspace{4pt}}

% Summary: muted band + 2pt left accent bar
\newcommand{\cvSummary}[1]{%
  \noindent
  \begin{tikzpicture}
    \node[
      fill=cvgrouped,
      inner xsep=8pt,
      inner ysep=5pt,
      text width=\dimexpr\textwidth-20pt\relax,
      align=left,
      anchor=north west
    ] (s) at (0,0) {\cvTypeBody\color{cvlabel}#1};
    \fill[cvaccent] ([xshift=-2pt]s.north west) rectangle (s.south west);
  \end{tikzpicture}%
  \par\vspace{1pt}}

% ---------- Two-column body ----------
\newcommand{\cvLeftWidth}{0.63\textwidth}
\newcommand{\cvRightWidth}{0.33\textwidth}
\newenvironment{cvBody}{\noindent\begin{minipage}[t]{\cvLeftWidth}\cvTypeBody}%
  {\end{minipage}\par}
\newcommand{\cvColumnBreak}{\end{minipage}\hfill\begin{minipage}[t]{\cvRightWidth}\cvFootnote}
\newenvironment{cvSide}{\cvColumnBreak}{}

% ---------- Experience ----------
\newcommand{\cvExperience}[4]{%
  \vspace{4pt}%
  \noindent{\cvSubhead\color{cvlabel}#1}%
  \hfill{\cvCaptionA\color{cvsecondary}#3}\par
  \vspace{1pt}%
  {\cvFootnote\color{cvsecondary}#2\ifx\relax#4\relax\else\ ·\ #4\fi}\par
  \vspace{2pt}}

\newcommand{\cvRole}[2]{%
  \vspace{2pt}%
  \noindent{\fontsize{9.5}{12}\selectfont\bfseries\color{cvlabel}#1}%
  \hfill{\cvCaptionB\color{cvtertiary}#2}\par
  \vspace{1pt}}

\newcommand{\cvRoleLine}[1]{%
  \noindent{\cvCaptionA\color{cvsecondary}#1}\par\vspace{1pt}}

\newcommand{\cvBullet}[1]{%
  \noindent\hangindent=0.85em\hangafter=1%
  \makebox[0.85em][l]{\raisebox{0.35ex}{\color{cvtertiary}\rule{0.28em}{0.28em}}}%
  {\cvTypeBody\color{cvlabel}#1}\par\vspace{1pt}}

\newcommand{\cvEarlier}[1]{%
  \vspace{6pt}%
  {\color{cvseparator}\hrule height 0.5pt}\vspace{4pt}%
  {\cvCaptionA\bfseries\color{cvsecondary}Earlier\par}%
  \vspace{2pt}%
  {\raggedright\cvCaptionA\color{cvsecondary}\noindent #1\par}\vspace{1pt}}

\let\cvJob\cvExperience

% ---------- Skills: compact bordered chips ----------
\newif\ifcvpillopen
\newcommand{\cvPill}[1]{%
  \ifcvpillopen\unskip\hspace{2pt}\else\cvpillopentrue\fi
  {\setlength{\fboxsep}{1.8pt}\setlength{\fboxrule}{0.35pt}%
   \fcolorbox{cvseparator}{cvgrouped}{%
     {\fontsize{6.8}{8}\selectfont\color{cvlabel}#1}}}%
}

\expandafter\def\csname cvcat@Aws\endcsname{AWS}
\expandafter\def\csname cvcat@Alicloud\endcsname{Alibaba Cloud}
\expandafter\def\csname cvcat@Devops\endcsname{DevOps}
\expandafter\def\csname cvcat@Ai\endcsname{AI}
\newcommand{\cvCatLabel}[1]{%
  \ifcsname cvcat@#1\endcsname\csname cvcat@#1\endcsname\else#1\fi}

\newcommand{\cvSkillGroup}[2]{%
  \cvpillopenfalse
  \noindent{\cvCaptionA\bfseries\color{cvsecondary}\cvCatLabel{#1}\par}%
  \vspace{1.5pt}%
  \noindent\raggedright #2\par
  \vspace{4pt}}

% ---------- Certifications: two-column table (description | year) ----------
\newenvironment{cvCertTable}{%
  \noindent
  \begin{tabular*}{\linewidth}{@{}
    >{\raggedright\arraybackslash}p{\dimexpr\linewidth-2.4em\relax}
    @{\extracolsep{\fill}}
    >{\raggedleft\arraybackslash}p{2.2em}@{}}%
}{%
  \end{tabular*}\par
}

% #1 title  #2 issuer (unused on-page; kept for sync API)  #3 year
\newcommand{\cvCertification}[3]{%
  {\cvCaptionA\color{cvlabel}#1}%
  &
  {\cvCaptionB\color{cvsecondary}#3}%
  \\[2.8pt]}

% ---------- Education ----------
\newcommand{\cvEducation}[4]{%
  \vspace{2pt}%
  \noindent{\cvFootnote\bfseries\color{cvlabel}#1}%
  \hfill{\cvCaptionB\color{cvtertiary}#3}\par
  {\cvCaptionA\color{cvsecondary}#2\ifx\relax#4\relax\else\ ·\ #4\fi\par}%
  \vspace{4pt}}

\endinput
